{
  "name": "kaamsetu",
  "private": true,
  "version": "0.1.0",
  "description": "Hyperlocal digital labour marketplace for India's daily wage workers",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @kaamsetu/api",
    "dev:api": "npm run dev -w @kaamsetu/api",
    "dev:web": "npm run dev -w @kaamsetu/web",
    "build": "npm run build -w @kaamsetu/shared && npm run build -w @kaamsetu/api && npm run build -w @kaamsetu/web",
    "build:shared": "npm run build -w @kaamsetu/shared",
    "build:api": "npm run build -w @kaamsetu/shared && npm run build -w @kaamsetu/api",
    "start:api": "npm run start -w @kaamsetu/api",
    "seed": "npm run seed -w @kaamsetu/api",
    "test": "npm run test -w @kaamsetu/shared && npm run test -w @kaamsetu/api",
    "test:shared": "npm run test -w @kaamsetu/shared",
    "test:api": "npm run test -w @kaamsetu/api",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.1",
    "typescript": "^5.6.3"
  }
}
